<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lista_videojuegos.Models"
             xmlns:vm="clr-namespace:Lista_videojuegos.ViewModels"
             x:DataType="vm:ListaViewModel"
             x:Class="Lista_videojuegos.Views.ListaPage"
             x:Name="PageRoot">

    <Grid RowDefinitions="*,Auto">

        <CollectionView ItemsSource="{Binding Videojuegos}"
                        SelectionMode="None"
                        Margin="10"
                        Grid.Row="0">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Videojuego">

                    <Grid Padding="10"
                          ColumnDefinitions="80,*">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding BindingContext.NavigateToDetalleCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}" />

                        </Grid.GestureRecognizers>

                        <Image Source="{Binding ImagenUrl}"
                               HeightRequest="60"
                               WidthRequest="60"
                               Aspect="AspectFill"
                               Grid.Column="0" />

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="10,0,0,0"
                                             VerticalOptions="Center">

                            <Label Text="{Binding Nombre}"
                                   FontAttributes="Bold"
                                   FontSize="16" />

                            <Label Text="{Binding Descripcion}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   LineBreakMode="TailTruncation" />

                        </VerticalStackLayout>

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Text="Ver favoritos"
                Command="{Binding NavigateToFavoritosCommand}"
                Margin="10"
                Grid.Row="1" />

    </Grid>

</ContentPage>